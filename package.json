{
  "name": "open-dicom",
  "version": "1.0.0",
  "description": "Modular, open-source DICOM viewer web application with TypeScript and Cornerstone.js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "lerna run build",
    "build:dev": "NODE_ENV=development lerna run build",
    "build:prod": "NODE_ENV=production lerna run build",
    "build:analyze": "ANALYZE=true NODE_ENV=production lerna run build",
    "test": "lerna run test",
    "test:watch": "lerna run test:watch",
    "test:coverage": "lerna run test:coverage",
    "lint": "lerna run lint",
    "lint:fix": "lerna run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "lerna run clean",
    "clean:deps": "lerna clean -y && rm -rf node_modules",
    "bootstrap": "lerna bootstrap",
    "publish": "lerna publish",
    "docs": "lerna run docs",
     "docs:build": "lerna run docs:build",
     "typecheck": "lerna run typecheck",
     "bundle:analyze": "lerna run bundle:analyze",
     "version": "lerna version",
     "dev": "lerna run dev --parallel",
     "prepare": "husky install",
     "analyze": "node scripts/bundle-analyzer.js",
     "analyze:ci": "npm run build && npm run analyze"
   },
  "keywords": [
    "dicom",
    "medical-imaging",
    "cornerstone",
    "typescript",
    "monorepo",
    "viewer"
  ],
  "author": "OpenDicom Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opendicom/dicom-viewer.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.0.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.5",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "lerna": "^8.0.0",
    "prettier": "^3.1.0",
    "rollup": "^4.6.1",
    "rollup-plugin-analyzer": "^4.0.0",
    "rollup-plugin-filesize": "^10.0.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "jest-environment-jsdom": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@testing-library/react-hooks": "^8.0.1",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "typedoc": "^0.25.4",
    "typedoc-plugin-markdown": "^3.17.1",
    "typedoc-plugin-merge-modules": "^5.1.0",
    "@typedoc/plugin-pages": "^0.1.0",
    "prettier": "^3.1.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "compression-webpack-plugin": "^11.0.0",
    "ts-loader": "^9.5.1",
    "babel-loader": "^9.1.3",
    "@babel/preset-env": "^7.23.6",
    "@babel/preset-react": "^7.23.3",
    "style-loader": "^3.3.3",
    "css-loader": "^6.8.1"
  }
}
