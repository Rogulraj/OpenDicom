{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@opendicom/core": ["packages/core/src"],
      "@opendicom/core/*": ["packages/core/src/*"],
      "@opendicom/viewport": ["packages/core1/viewport/src"],
      "@opendicom/viewport/*": ["packages/core1/viewport/src/*"],
      "@opendicom/image-loader": ["packages/image-loader/src"],
      "@opendicom/image-loader/*": ["packages/image-loader/src/*"],
      "@opendicom/events": ["packages/events/src"],
      "@opendicom/events/*": ["packages/events/src/*"],
      "@opendicom/ui": ["packages/ui/src"],
      "@opendicom/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/types/**/*",
    "tools/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "**/build",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ],
  "references": [
    { "path": "./packages/core/core" },
    { "path": "./packages/core/viewport" },
    { "path": "./packages/core/image-loader" },
    { "path": "./packages/core/events" },
    { "path": "./packages/core/ui" }
  ]
}