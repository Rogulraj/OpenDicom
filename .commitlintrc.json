{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "build",
        "ci",
        "chore",
        "revert",
        "medical"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "core",
        "viewport",
        "image-loader",
        "events",
        "ui",
        "tools",
        "dicom",
        "rendering",
        "workflow",
        "deps",
        "config"
      ]
    ],
    "subject-case": [2, "always", "lower-case"],
    "subject-empty": [2, "never"],
    "subject-full-stop": [2, "never", "."],
    "type-case": [2, "always", "lower-case"],
    "type-empty": [2, "never"]
  }
}